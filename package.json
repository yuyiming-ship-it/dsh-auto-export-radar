{
  "name": "dsh-auto-export-radar",
  "version": "1.11.0",
  "private": true,
  "description": "中国汽车出海雷达 · DSH 插件：左侧栏常驻面板，15 个语种 / 26 个 Google News 本地版 + 56 个 RSS（波斯语 18 个源）+ 17 个官方信源（含俄罗斯法令增量监控）（部委/海关/公报），标题自动翻成中文，面板内读正文并可一键译成中文，支持已读/收藏/关注词/自定义订阅/OPML，可选接入 X / Facebook / Threads。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "china-auto",
    "vehicle-export",
    "news-radar",
    "rss",
    "translation",
    "arabic",
    "russian",
    "persian",
    "french"
  ],
  "author": "yuyiming-ship-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyiming-ship-it/dsh-auto-export-radar.git"
  },
  "homepage": "https://github.com/yuyiming-ship-it/dsh-auto-export-radar#readme",
  "bugs": {
    "url": "https://github.com/yuyiming-ship-it/dsh-auto-export-radar/issues"
  },
  "engines": {
    "dsh": ">=0.2.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "feed.js",
    "article.js",
    "radar.js",
    "social.js",
    "client.js",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
